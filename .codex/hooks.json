{
  "description": "Thin adapter: runs the canonical agent hooks in .agents/hooks/ (see AGENTS.md). Put hook logic there, not here.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-git.py\" --adapter codex",
            "timeout": 10,
            "statusMessage": "Checking git command"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-git.py\" --adapter codex",
            "timeout": 10,
            "statusMessage": "Checking MCP tool call"
          }
        ]
      }
    ]
  }
}
