<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 on Microsoft.Testing.Platform: the test project is an executable (.ai/rules/testing.md). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Starts the real Rva.Host in memory (WebApplicationFactory) to check its wiring. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rva.Backend\Rva.Host\Rva.Host.csproj" />
  </ItemGroup>

</Project>
