<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 on Microsoft.Testing.Platform: the test project is an executable (.ai/rules/testing.md). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Every backend project must be referenced here so its assembly is built and checked.
       ProjectReferenceTests fails if one is missing. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rva.Backend\Rva.Host\Rva.Host.csproj" />
    <ProjectReference Include="..\..\src\Rva.Backend\Rva.SharedKernel\Rva.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Rva.Backend\Modules\Rva.Modules.GridTopology\Rva.Modules.GridTopology.csproj" />
    <ProjectReference Include="..\..\src\Rva.Backend\Modules\Rva.Modules.GridTopology.Contracts\Rva.Modules.GridTopology.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Rva.Backend\Modules\Rva.Modules.Telemetry\Rva.Modules.Telemetry.csproj" />
    <ProjectReference Include="..\..\src\Rva.Backend\Modules\Rva.Modules.Telemetry.Contracts\Rva.Modules.Telemetry.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Rva.Backend\Modules\Rva.Modules.Simulation\Rva.Modules.Simulation.csproj" />
    <ProjectReference Include="..\..\src\Rva.Backend\Modules\Rva.Modules.Simulation.Contracts\Rva.Modules.Simulation.Contracts.csproj" />
  </ItemGroup>

</Project>
